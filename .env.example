
# ==========================================
# OpenAI Configuration
# ==========================================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# ==========================================
# FastOCR Configuration
# ==========================================
FASTOCR_API_KEY=

# ==========================================
# LangSmith Configuration
# ==========================================
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false

# ==========================================
# OCR Configuration
# ==========================================
OCR_ENGINE=
OCR_LANGS=
RENDER_DPI=300
MIN_NATIVE_CHARS=50
OCR_ALL_PAGES=false
OCR_MERGE_WITH_NATIVE=true

# ==========================================
# Embedding Configuration
# ==========================================
EMBEDDING_MODEL=

# ==========================================
# Qdrant Configuration
# ==========================================
QDRANT_API_KEY=
QDRANT_API_ENDPOINT=
QDRANT_COLLECTION_NAME=
QDRANT_SUMMARY_COLLECTION_NAME=

# ==========================================
# Aiven PostgreSQL Configuration
# ==========================================
AIVEN_POSTGRES_URI=

# ==========================================
# Aiven Redis Configuration
# ==========================================
AIVEN_REDIS_URI=

# ==========================================
# Storage Configuration
# ==========================================
# Options: local, b2
STORAGE_PROVIDER=local

# ==========================================
# Backblaze B2 Configuration
# ==========================================
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT_URL=

# Jina Embedding and Reranking API
JINA_API_KEY=replace-with-GATEWAY_API_KEY
JINA_API_BASE_URL=http://127.0.0.1:8090/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_EMBEDDING_DIMENSIONS=1024
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual
JINA_API_TIMEOUT_SECONDS=120
JINA_EMBEDDING_BATCH_SIZE=64

# Optional explicit names for the new Jina vector collections.
# Defaults append _jina_v5_1024 to the legacy QDRANT_COLLECTION_NAME values.
JINA_QDRANT_COLLECTION_NAME=
JINA_QDRANT_SUMMARY_COLLECTION_NAME=
